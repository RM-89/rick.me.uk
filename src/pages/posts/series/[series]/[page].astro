---
import type { GetStaticPathsOptions } from "astro";
import { loadAndFormatCollection, getSeriesItems } from "../../../../scripts/utils/collection";

import Layout from "../../../../layouts/Layout.astro";
import Container from "../../../../components/Container.astro";
import Header from "../../../../components/Header.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostCard from "../../../../components/PostCard.astro";

export async function getStaticPaths(options: GetStaticPathsOptions) {
    const posts = await loadAndFormatCollection("posts");
    const series = await getSeriesItems(posts);

    return series.flatMap((seriesItem: any) => {
        const filteredPosts = posts
            .filter((post: any) => post.data.series === seriesItem.slug)
            .sort(
                (a: any, b: any) =>
                    a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
            );

        return options.paginate(filteredPosts, {
            params: { series: seriesItem.slug },
            pageSize: 10,
        });
    });
}

const { page } = Astro.props;
const { series } = Astro.params;

const seriesItems = await getSeriesItems(await loadAndFormatCollection("posts"));
const seriesItem = seriesItems.find((item: any) => item.slug === series);
---

<Layout title={`Posts in '${seriesItem.data.title}'`}>
    <Container maxWidth="900px">
        <Header title={`Series: ${seriesItem.data.title}`}>
            <p class="description">{seriesItem.data.description}</p>
        </Header>

        <div class="posts">
            {page.data.map((post) => <PostCard post={post} withTags={true} />)}
        </div>

        <Pagination page={page} />
    </Container>
</Layout>

<style lang="scss">
.description {
    margin: 0 0 2rem 0;
    font-size: 1.2rem;
    color: var(--color-foreground-muted-2);
}
</style>
