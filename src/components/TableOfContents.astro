---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  levels?: 1 | 2 | 3;
}

const { headings, levels = 3 } = Astro.props as Props;

const filteredHeadings = headings.filter((heading) => heading.depth <= levels);
---

<div class="toc">
    <h4>In this post</h4>
    <ul>
        {
            filteredHeadings.map((heading) => (
                <li>
                    <a href={`#${heading.slug}`} data-slug={heading.slug}>
                        {heading.text}
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<script>
    const wideDisplay = window.matchMedia("(min-width: 48rem)");
    const toc = document.querySelector(".toc");

    if (wideDisplay.matches && toc) {
        const links = [...toc.querySelectorAll("a[data-slug]")];
        const headings = links
            .map((link) => document.getElementById(link.dataset.slug))
            .filter(Boolean);
        const linkBySlug = new Map(links.map((link) => [link.dataset.slug, link]));

        let activeSlug = null;

        const clearActive = () => {
            linkBySlug.get(activeSlug)?.classList.remove("active");
            activeSlug = null;
        };

        const update = () => {
            const threshold = window.innerHeight / 2;
            let slug = null;

            for (const heading of headings) {
                if (heading.getBoundingClientRect().top > threshold) break;
                slug = heading.id;
            }

            if (slug === null && headings.length > 0) {
                slug = headings[0].id;
            }

            if (slug !== activeSlug) {
                linkBySlug.get(activeSlug)?.classList.remove("active");
                linkBySlug.get(slug)?.classList.add("active");
                activeSlug = slug;
            }
        };

        document.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
        update();
    }
</script>

<style lang="scss">
.toc {
    position: sticky;
    top: 4.25em;
    margin-top: 0.6rem;
    padding: 0.5rem 1.5em 0 0;

    h4 {
        margin: 0 0 .5rem 0;
        font-size: 1.3rem;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;

        li {
            margin: .5rem 0;

            a {
                display: block;
                padding: 0 0 0 .75rem;
                border-left: 3px solid var(--color-overlay-light);
                font-weight: 500;
                color: var(--color-foreground-muted-3);
                text-decoration: none;

                &:hover {
                    border-left-color: var(--color-foreground);
                    color: var(--color-foreground);
                }

            }

            :global(a.active) {
                border-left-color: var(--color-brand);
                color: var(--color-brand);
            }
        }
    }
}
</style>
